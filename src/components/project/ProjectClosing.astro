---
import NextProjectLink from '@/components/project/NextProjectLink.astro';
import Ambient from '@/components/ui/Ambient.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import DisplayHeading from '@/components/ui/DisplayHeading.astro';
import Lede from '@/components/ui/Lede.astro';
import Section from '@/components/ui/Section.astro';
import { sectionHref } from '@/data/sections';
import { getDictionary } from '@/i18n/getDictionary';
import type { Locale } from '@/i18n/locales';
import type { Project } from '@/lib/projects';

interface Props {
  next: Project;
  locale: Locale;
}

const { next, locale } = Astro.props;
const t = getDictionary(locale).project.closing;
---

<Section label={t.label} clipped>
  <Ambient slot="backdrop" />
  <Container elevated class="stack">
    <NextProjectLink project={next} eyebrow={t.next} />
    <div class="invite reveal">
      <DisplayHeading title={t.title} size="md" />
      <Lede>{t.lede}</Lede>
      <Button variant="secondary" href={sectionHref(locale, 'contact')}>{t.action}</Button>
    </div>
  </Container>
</Section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .invite {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
</style>
