---
import SkillGroupCell from '@/components/home/SkillGroupCell.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { sectionIds } from '@/data/sections';
import { skillGroups } from '@/data/skills';
import { getDictionary } from '@/i18n/getDictionary';
import type { Locale } from '@/i18n/locales';
import { localize } from '@/i18n/localize';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).skills;
---

<Section id={sectionIds.skills} labelledby="skills-title">
  <Container class="stack">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} lede={t.lede} headingId="skills-title" />
    <div class="grid">
      {skillGroups.map((group, index) => <SkillGroupCell group={localize(group, locale)} index={index} />)}
    </div>
  </Container>
</Section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--line);
  }
</style>
