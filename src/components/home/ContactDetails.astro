---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Metric from '@/components/ui/Metric.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { site } from '@/data/site';
import { getDictionary } from '@/i18n/getDictionary';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { contact, profile } = getDictionary(Astro.props.locale);
---

<div class="details">
  <div class="block">
    <Eyebrow tone="light">{contact.details.email}</Eyebrow>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
  <div class="block">
    <Eyebrow tone="light">{contact.details.socials}</Eyebrow>
    <ul class="socials">
      {
        site.socials.map((social) => (
          <li>
            <TextLink tone="light" href={social.href} rel="me noopener">
              {social.label}
            </TextLink>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="block">
    <Eyebrow tone="light">{contact.details.location}</Eyebrow>
    <Metric>{profile.location} · {profile.remote}</Metric>
  </div>
</div>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .email {
    font: 600 24px/32px var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email:hover {
    color: var(--violet-light);
  }

  .email:focus-visible {
    outline: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--focus-ring);
  }

  .socials {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 0;
    list-style: none;
  }
</style>
