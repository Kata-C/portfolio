---
import Chip from '@/components/ui/Chip.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { SkillGroup } from '@/data/skills';

interface Props {
  group: SkillGroup;
  index: number;
}

const { group, index } = Astro.props;
---

<div class="cell reveal" style={`--i: ${index}`}>
  <Eyebrow>{group.name}</Eyebrow>
  <ul class="items">
    {
      group.items.map((item) => (
        <li>
          <Chip tone="neutral">{item}</Chip>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    background: var(--void);
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .items li {
    display: flex;
  }
</style>
