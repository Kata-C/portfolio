---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'label'> {
  as?: 'p' | 'span' | 'dt' | 'legend' | 'label';
  tone?: 'accent' | 'light' | 'muted';
}

const { as: Element = 'p', tone = 'accent', class: className, ...rest } = Astro.props;
---

<Element class:list={['eyebrow', `eyebrow-${tone}`, className]} {...rest}>
  <slot />
</Element>

<style>
  .eyebrow {
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow-accent {
    color: var(--violet);
  }

  .eyebrow-light {
    color: var(--violet-light);
  }

  .eyebrow-muted {
    color: var(--ink-muted);
  }
</style>
