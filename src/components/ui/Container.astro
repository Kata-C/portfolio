---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  width?: 'default' | 'wide';
  elevated?: boolean;
}

const { width = 'default', elevated = false, class: className, ...rest } = Astro.props;
---

<div class:list={['container', `container-${width}`, { elevated }, className]} {...rest}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .container-default {
    max-width: var(--container);
  }

  .container-wide {
    max-width: var(--container-wide);
  }

  .elevated {
    position: relative;
    z-index: 1;
  }
</style>
