---
interface Props {
  live?: boolean;
}

const { live = false } = Astro.props;
---

<span class:list={['tag', 'glass', { 'tag-live': live }]}>
  {live && <span class="dot" aria-hidden="true" />}
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px var(--space-3);
    border-radius: var(--radius-sm);
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .tag-live {
    color: var(--ink);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--cyan);
    box-shadow: var(--glow-cyan);
    animation: pulse 2s var(--ease-in-out) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.35;
      transform: scale(0.7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>
