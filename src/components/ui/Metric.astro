---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'p'> {
  as?: 'p' | 'span' | 'dd';
  tone?: 'muted' | 'ink';
}

const { as: Element = 'p', tone = 'muted', class: className, ...rest } = Astro.props;
---

<Element class:list={['metric', `metric-${tone}`, className]} {...rest}>
  <slot />
</Element>

<style>
  .metric {
    font: 400 14px/22px var(--font-mono);
  }

  .metric-muted {
    color: var(--ink-muted);
  }

  .metric-ink {
    color: var(--ink);
  }
</style>
