---
import Container from '@/components/ui/Container.astro';
import Metric from '@/components/ui/Metric.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { sectionIds } from '@/data/sections';
import { site } from '@/data/site';
import { getDictionary } from '@/i18n/getDictionary';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const t = getDictionary(Astro.props.locale).footer;
const copyright = `© ${new Date().getFullYear()} ${site.name}`;
---

<footer class="footer">
  <Container class="bar">
    <Metric as="span">{copyright}</Metric>
    <TextLink href={`#${sectionIds.top}`}>{t.backToTop}</TextLink>
  </Container>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }
</style>
