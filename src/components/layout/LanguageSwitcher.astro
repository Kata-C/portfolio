---
import type { Alternate } from '@/i18n/alternates';
import { localeDetails, type Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  alternates: Alternate[];
  label: string;
}

const { locale, alternates, label } = Astro.props;
---

<ul class="switcher" aria-label={label}>
  {
    alternates.map((alternate) => {
      const details = localeDetails[alternate.locale];
      const active = alternate.locale === locale;

      return (
        <li>
          <a
            class:list={['option', { active }]}
            href={alternate.href}
            hreflang={alternate.locale}
            lang={alternate.locale}
            aria-current={active ? 'true' : undefined}
          >
            <span aria-hidden="true">{details.short}</span>
            <span class="visually-hidden">{details.name}</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .switcher {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    list-style: none;
  }

  .option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 30px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-standard),
      background-color var(--dur-fast) var(--ease-standard);
  }

  .option:hover {
    color: var(--ink);
  }

  .active {
    background: var(--violet-soft);
    color: var(--violet-light);
  }

  .option:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
</style>
